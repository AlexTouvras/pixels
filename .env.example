CURSOR_API_KEY=
# Optional model override (default: composer-2.5)
# CURSOR_MODEL=composer-2.5
# Force cloud agents locally (default: cloud on Vercel, local elsewhere)
# CURSOR_AGENT_RUNTIME=cloud
# Required for cloud if not deploying from a linked GitHub repo on Vercel:
# CURSOR_CLOUD_REPO_URL=https://github.com/OWNER/pixels
# Optional cloud checkout ref (default: master, or VERCEL_GIT_COMMIT_REF on Vercel)
# CURSOR_CLOUD_STARTING_REF=master
